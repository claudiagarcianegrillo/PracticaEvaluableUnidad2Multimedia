<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FCE4EC"
    android:padding="24dp">

    <!-- Título de la página: LumiSkin (app para maquillaje).
    Se ajusta al ancho y al alto necesario, muestra el texto LumiSkin,
    el texto está en negrita, también tiene el color rosa, y ancla el texto
    a los 4 extremos de la pantalla para que quede centrado. -->
    <TextView
        android:id="@+id/texto_logo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="LumiSkin"
        android:textSize="42sp"
        android:textStyle="bold"
        android:textColor="#880E4F"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.22" />

    <!-- Campo Usuario con el fondo personalizado.
    Aplica un archivo gráfico personalizado como fondo del campo de texto. -->
    <EditText
        android:id="@+id/edit_usuario"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:background="@drawable/fondo_input"
        android:hint="@string/usuario"
        android:inputType="text"
        android:minHeight="52dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="#000000"
        android:textColorHint="#9E9E9E"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/texto_logo" />

    <!-- Campo Contraseña con el fondo personalizado.
     Exactamente igual que el campo de Usuario. -->
    <EditText
        android:id="@+id/edit_password"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/fondo_input"
        android:hint="@string/password"
        android:inputType="textPassword"
        android:minHeight="52dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="#000000"
        android:textColorHint="#9E9E9E"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/edit_usuario" />

    <!-- Botón de validar -->
    <Button
        android:id="@+id/boton_validar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="32dp"
        android:text="@string/boton_validar"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        app:backgroundTint="#880E4F"
        app:cornerRadius="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/edit_password" />

</androidx.constraintlayout.widget.ConstraintLayout>