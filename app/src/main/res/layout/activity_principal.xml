<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FCE4EC"
    android:padding="20dp">

    <!-- Título de la página -->
    <TextView
        android:id="@+id/texto_titulo_pagina"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Skincare"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="#880E4F"
        android:gravity="center"
        android:layout_marginTop="28dp"
        android:layout_marginBottom="4dp" />

    <!-- Datos recibidos del login -->
    <TextView
        android:id="@+id/texto_datos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:textSize="14sp"
        android:textColor="#666666"
        android:gravity="center" />

    <!-- Tarjeta 1 -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        card_view:cardBackgroundColor="#FFFFFF"
        card_view:cardCornerRadius="16dp"
        card_view:cardElevation="4dp"
        card_view:contentPadding="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/titulo1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/titulo_card1"
                android:textSize="16sp"
                android:textColor="#880E4F"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <ImageView
                android:id="@+id/imagen1"
                android:layout_width="65dp"
                android:layout_height="65dp"
                android:layout_marginBottom="6dp"
                android:scaleType="centerCrop"
                android:src="@drawable/limpiezafacial" />

            <TextView
                android:id="@+id/descripcion1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/descripcion_card1"
                android:textColor="#555555"
                android:textSize="13sp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Tarjeta 2 -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        card_view:cardBackgroundColor="#FFFFFF"
        card_view:cardCornerRadius="16dp"
        card_view:cardElevation="4dp"
        card_view:contentPadding="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/titulo2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/titulo_card2"
                android:textSize="16sp"
                android:textColor="#880E4F"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <ImageView
                android:id="@+id/imagen2"
                android:layout_width="65dp"
                android:layout_height="65dp"
                android:layout_marginBottom="6dp"
                android:scaleType="centerCrop"
                android:src="@drawable/hidratacion" />

            <TextView
                android:id="@+id/descripcion2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/descripcion_card2"
                android:textColor="#555555"
                android:textSize="13sp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Tarjeta 3 -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        card_view:cardBackgroundColor="#FFFFFF"
        card_view:cardCornerRadius="16dp"
        card_view:cardElevation="4dp"
        card_view:contentPadding="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/titulo3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/titulo_card3"
                android:textSize="16sp"
                android:textColor="#880E4F"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <ImageView
                android:id="@+id/imagen3"
                android:layout_width="65dp"
                android:layout_height="65dp"
                android:layout_marginBottom="6dp"
                android:scaleType="centerCrop"
                android:src="@drawable/protectorsolar" />

            <TextView
                android:id="@+id/descripcion3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/descripcion_card3"
                android:textColor="#555555"
                android:textSize="13sp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Este botón sirve para poder desconectarnos y volver a la
    pagina del login y poder volver a registrarnos tantas veces como
    queramos -->
    <Button
        android:id="@+id/btn_desconectar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Desconectarse"
        android:backgroundTint="#880E4F"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>